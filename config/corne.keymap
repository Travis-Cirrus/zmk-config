#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/mouse.h>

/ {
        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB   |   Q   |   W   |   E   |   R   |   T   |   |   Y   |   U   |   I   |   O   |   P   |  BSPC  |
// |  CTRL  |   A   |   S   |   D   |   F   |   G   |   |   H   |   J   |   K   |   L   |   ;   |   '    |
// |  SHFT  |   Z   |   X   |   C   |   V   |   B   |   |   N   |   M   |   ,   |   .   |   /   |  ESC   |
//                          |  ALT  |  GUI  |  SPC  |   |  ENT  |  LWR  |  RSE  |
                        bindings = <
    &kp TAB    &kp Q    &kp W    &kp E     &kp R     &kp T        &kp Y      &kp U     &kp I      &kp O    &kp P     &kp BSPC
    &kp LCTRL  &kp A    &kp S    &kp D     &kp F     &kp G        &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
    &kp LSHFT  &kp Z    &kp X    &kp C     &kp V     &kp B        &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                 &kp LALT  &kp LGUI  &kp SPACE    &kp RET    &mo 1     &mo 2
                        >;
                };

                lower_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TRANS |   1   |   2   |   3   |   !   |   (   |   |   )   |   &   |   *   |   -   |   =   |  TRANS |
// |  TRANS |   4   |   5   |   6   |   ^   |   [   |   |   ]   |   |   |   \   |   _   |   +   |   `    |
// |  TRANS |   7   |   8   |   9   |   0   |   {   |   |   }   |   @   |   #   |   $   |   %   |   ~    |
//                          | TRANS | TRANS | TRANS |   | TRANS | TRANS | TRANS |
                        bindings = <
    &trans  &kp N1  &kp N2  &kp N3    &kp EXCL   &kp LPAR     &kp RPAR  &kp AMPS   &kp ASTRK  &kp MINUS  &kp EQUAL   &trans
    &trans  &kp N4  &kp N5  &kp N6    &kp CARET  &kp LBKT     &kp RBKT  &kp PIPE   &kp BSLH   &kp UNDER  &kp PLUS    &kp GRAVE
    &trans  &kp N7  &kp N8  &kp N9    &kp N0     &kp LBRC     &kp RBRC  &kp AT     &kp HASH   &kp DLLR   &kp PRCNT   &kp TILDE
                            &trans    &trans     &trans       &trans    &trans     &trans
                        >;
                };

                raise_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TRANS |  F1   |  F2   |  F3   |  F10  |  NO   |   |  NO   |  NO   |  NO   |  NO   |  NO   |  NO    |
// |  TRANS |  F4   |  F5   |  F6   |  F11  |  NO   |   | LEFT  | DOWN  |  UP   | RIGHT |  NO   |  NO    |
// |  TRANS |  F7   |  F8   |  F9   |  F12  | TRANS |   | TRANS | TRANS | TRANS | TRANS | TRANS |  TRANS |
//                          | TRANS | TRANS | TRANS |   | TRANS | TRANS | TRANS |
                        bindings = <
    &trans  &kp F1  &kp F2  &kp F3  &kp F10  &none     &none   &none     &none   &none      &none   &none
    &trans  &kp F4  &kp F5  &kp F6  &kp F11  &none     &kp LEFT &kp DOWN &kp UP  &kp RIGHT  &none   &none
    &trans  &kp F7  &kp F8  &kp F9  &kp F12  &trans    &trans  &trans    &trans  &trans     &trans  &trans
                            &trans  &trans   &trans    &trans  &trans    &trans
                        >;
                };

                nav_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  LYR4  | SCRL_R| MW_U  | MW_D  |SCRL_L | MB1   |   | HOME  | PG_UP | PG_DN |  END  |  NO   |  NO    |
// |  NO    | M_LT  | M_DN  | M_UP  | M_RT  | MB2   |   |  NO   |  NO   |  NO   |  NO   |  NO   | EP_TOG |
// |  BT 0  | BT 1  | BT 2  | BT 3  | BT 4  | BTCLR |   |  USB  |  BLE  |  NO   |  NO   | RESET | BOOTL  |
//                          | TRANS | TRANS | TRANS |   |  NO   | TRANS | TRANS |
                        bindings = <
    &mo 4         &msc SCRL_RIGHT  &msc SCRL_UP    &msc SCRL_DOWN   &msc SCRL_LEFT   &mkp MB1      &kp HOME      &kp PG_UP     &kp PG_DN  &kp END  &none        &none
    &none         &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_UP     &mmv MOVE_RIGHT  &mkp MB2      &none         &none         &none      &none    &none        &ext_power EP_TOG
    &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4     &bt BT_CLR    &out OUT_USB  &out OUT_BLE  &none      &none    &sys_reset   &bootloader
                                                   &trans           &trans           &trans        &none         &trans        &trans
                        >;
                };

                rgb_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TRANS |  TRANS |  TRANS |  TRANS |  TRANS |  TRANS |   | BRI+  | HUE+  | SAT+  | EFF+  | TOG   |  TRANS |
// |  TRANS |  TRANS |  TRANS |  TRANS |  TRANS |  TRANS |   | BRI-  | HUE-  | SAT-  | EFF-  | TRANS |  TRANS |
// |  TRANS |  TRANS |  TRANS |  TRANS |  TRANS |  TRANS |   | TRANS | TRANS | TRANS | TRANS | TRANS |  TRANS |
//                            | TRANS | TRANS | TRANS |   | TRANS | TRANS | TRANS |
                        bindings = <
    &trans  &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &trans
    &trans  &trans  &trans  &trans  &trans  &trans    &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_EFR  &trans           &trans
    &trans  &trans  &trans  &trans  &trans  &trans    &trans           &trans           &trans           &trans           &trans           &trans
                            &trans  &trans  &trans    &trans           &trans           &trans
                        >;
                };
        };
};
