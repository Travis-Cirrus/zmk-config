#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/led/led.h>

/ {
        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <2 3>;
                        then-layer = <4>;
                };
        };

        chosen {
                zmk,underglow = <21>;
        }

        keymap {
                compatible = "zmk,keymap";

                nav_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB      |  MW_U        |  MW_D         | LT_Cl          | RT_CL        |                |   |     HOME    |  PG_UP    | PG_DN     |    END    |       |    BSP C  |
// |  CTRL     |              |  M_LT         |  M_DN          | M_UP         |    M_RT        |   |     LEFT    |   DOWN    |   UP      |   RIGHT   |       |           |
// |  SHFT     |  UNDO        |  CUT          |  COPY          | PASTE        |                |   |     WORD-   |           |           |   WORD+   |       |    ESC    |
//                                            |  ALT           | GUI          |    SPC         |   |    ENT/WM   |   LWR     |  RSE      | 
                        bindings = <
    &kp TAB      &msc SCRL_UP  &msc SCRL_DOWN   &mkp MB1         &mkp MB2       &trans                 &kp HOME    &kp PG_UP   &kp PG_DN   &kp END     &trans    &kp BSPC
    &kp LCTRL    &trans        &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP   &mmv MOVE_RIGHT        &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &trans    &trans
    &kp LSFT     &kp K_UNDO     &kp  K_CUT         &kp  K_COPY        &kp K_PASTE     &trans                 &trans      &kp LALT    &trans      &trans      &trans    &kp ESC
                                                &kp LALT         &kp LGUI       &kp SPC                &lt 5 RET   &mo 2       &mo 3
                        >;
                };
                insert_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB   |   Q   |   W   |   E   |   R   |   T   |   |   Y   |   U   |   I   |   O   |   P   |  BSPC  |
// |  CTRL  |   A   |   S   |   D   |   F   |   G   |   |   H   |   J   |   K   |   L   |   ;   |   '    |
// |  SHFT  |   Z   |   X   |   C   |   V   |   B   |   |   N   |   M   |   ,   |   .   |   /   |  ESC   |
//                          |  ALT  |  GUI  |  SPC  |   | ENT/WM|  LWR  |  RSE  |
                        bindings = <    
    &kp TAB   &kp Q   &kp W   &kp E   &kp R   &kp T       &kp Y   &kp U  &kp I     &kp O   &kp P    &kp BSPC
    &kp LCTRL &kp A   &kp S   &kp D   &kp F   &kp G       &kp H   &kp J  &kp K     &kp L   &kp SEMI &kp SQT
    &kp LSHFT &kp Z   &kp X   &kp C   &kp V   &kp B       &kp N   &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                          &kp LALT &kp LGUI &kp SPACE   &lt 5 RET &mo 1 &mo 2
                        >;
                };
                lower_layer {                  
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB     |   1    |    2    |    3    |     0     |     (    |   |     )    |     &     |     *     |      -      |    =      |    BSPC    |
// |  CTRL    |   4    |    5    |    6    |     !     |     [    |   |     ]    |     |     |     \     |      _      |    +      |     `      |
// |  SHFT    |   7    |    8    |    9    |           |     {    |   |     }    |           |           |             |           |            |
//                               |    GUI  |     GUI   |     SPC  |   |     ENT  |     ,     |     ALT   |
                        bindings = <
     &kp TAB    &kp N1    &kp N2    &kp N3    &kp N0     &kp LPAR       &kp RPAR    &kp AMPS    &kp ASTRK    &kp MINUS   &kp EQUAL   &kp BSPC
     &kp LCTRL  &kp N4    &kp N5    &kp N6    &kp EXCL   &kp LBKT       &kp RBKT    &kp PIPE    &kp BSLH     &kp UNDER   &kp PLUS    &kp GRAVE
     &kp LSHFT  &kp N7    &kp N8    &kp N9    &trans     &kp RBRC       &kp RBRC    &trans      &trans       &trans      &trans      &kp TILDE
                                    &kp LALT &kp LGUI &kp SPACE   &lt 5 RET &mo 1 &mo 2
                        >;
                };

                raise_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB   |       |       |       |       |       |   |       |       |       |       |       |  BSPC  |
// |  CTRL  |       |       |       |       |       |   |       |       |       |       |       |        |
// |  SHFT  |       |       |       |       |       |   |       |       |       |       |       |   ~    |
//                            | GUI |       |  SPC  |   | ENT/WM|       | ALT |
                        bindings = <
   &kp  TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &trans    &trans    &trans      &trans    &trans     &kp BSPC
   &kp  LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp  LSHFT &trans   &trans &trans   &trans   &trans      &trans    &trans    &trans      &trans    &trans     &kp ESC
                             &kp LALT &kp LGUI &kp SPACE   &lt 5 RET &mo 1 &mo 2
                        >;
                };

                fn_layer {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB   |  fn_1 |  fn_2 |  fn_3 | fn_10 |       |   |       |       |       |       |       |  BSPC  |
// |  CTRL  |  fn_4 |  fn_5 |  fn_6 | fn_11 |       |   |       |       |       |       |       |        |
// |  SHFT  |  fn_7 |  fn_8 |  fn_9 | fn_12 |       |   |       |       |       |       |       |  ESC   |
//                          |  ALT  |  GUI  |  SPC  |   | ENT/WM|  LWR  |  RSE  |
                        bindings = <
    &kp TAB     &kp F1    &kp F2    &kp F3    &kp F10    &trans       &trans    &trans    &trans      &trans    &trans     &kp BSPC
    &kp LCTRL   &kp F4    &kp F5    &kp F6    &kp F11    &trans       &trans    &trans    &trans      &trans    &trans     &kp SQT
    &kp LSHFT   &kp F7    &kp F8    &kp F9    &kp F12    &trans       &trans    &trans    &trans      &trans    &trans     &kp ESC
                          &kp LALT &kp LGUI &kp SPACE   &lt 5 RET &mo 1 &mo 2
                        >;
                };

                media_management {
// --------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// |  TAB   |       |       |   FS  |       |       |   |       |       |       |       |       |  BSPC  |
// |  CTRL  |       |       |       |       |       |   |   <   |   v   |   ^   |   >   |       |        |
// |  SHFT  |       |       | Center|       |       |   |       |       |       |       |       |  ESC   |
//                          |  ALT  |  GUI  |  SPC  |   | ENT/WM|  LWR  |  RSE  |
                        bindings = <
   &kp  TAB   &trans   &trans   &kp LC(LA(RET))   &trans   &trans    &trans             &trans           &trans          &trans             &trans   &trans
   &kp  LCTRL &trans   &trans   &trans            &trans   &trans    &kp LC(LA(LEFT))   &kp LC(LA(DOWN)) &kp LC(LA(UP))  &kp LC(LA(RIGHT))  &trans   &trans
   &kp  LSHFT &trans   &trans   &kp LC(LA(C))     &trans   &trans    &trans             &trans           &trans          &trans             &trans   &trans
                             &kp LALT &kp LGUI &kp SPACE   &lt 5 RET &mo 1 &mo 2
                        >;
                };
        };
};
